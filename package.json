{
  "name": "prometheus-alert-rule-companion",
  "displayName": "Prometheus Alert Rule Companion",
  "description": "Lints Prometheus alert rule YAML -- duplicate alert names, missing 'for', missing annotations, empty expr -- a text-only subset of pint's checks. No data leaves your editor.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "prometheus",    "promql",    "alerting",    "linter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-prometheus-alert-rule-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-prometheus-alert-rule-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
